  "bin": {
    "spec": "bin/spec.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alexkravets/dos.git"
  },
  "directories": {
    "src": "src"
  },
  "scripts": {
    "start": "npx http example/index.ts",
    "test": "eslint --fix src/ example/ && jest --coverage",
